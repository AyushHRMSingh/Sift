# Copy to .env (never commit it). All optional.
APP_USER=admin
APP_PASSWORD=change-me      # if unset, one is generated on first start and printed
# APP_PASSWORD_HASH=scrypt:...   # better: run `python -m jobfinder hash-password`, then delete APP_PASSWORD
PORT=48213
HOST=127.0.0.1              # keep on loopback; put a reverse proxy / tunnel in front
# SECURE_COOKIES=0          # only for plain-http local testing
# SINKS=jsonl               # export plugins, comma separated
# DATA_DIR=./data
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/ID/TOKEN   # alerts for new strong matches
# DISCORD_MIN_MATCH=70
# PUBLIC_URL=https://jobs.example.com                             # link included in alerts
# STALE_DAYS=30                       # hide jobs posted longer ago from swipe and alerts
# SCRAPE_PROXIES=user:pass@host:port  # comma separated; helps when LinkedIn rate-limits your IP
# REMINDER_TIMES=18:30,20:30          # daily Discord reminder of pending applications
# REMINDER_TZ=Asia/Kolkata
